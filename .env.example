# CloudLab Platform — Environment Variables
# Copy this to .env and fill in your values.
# NEVER commit .env to git.

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=cloudlab
POSTGRES_PASSWORD=cloudlab_dev
POSTGRES_DB=cloudlab

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=cloudlab_dev

# ── Keycloak ────────────────────────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_CLIENT_SECRET=dev-secret

# ── Backend ─────────────────────────────────────────────────────────────────
# Generate a strong secret: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me-with-a-strong-random-secret

# ── Stripe (billing — Phase 4) ───────────────────────────────────────────────
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── SendGrid (email — Phase 4) ───────────────────────────────────────────────
# SENDGRID_API_KEY=SG...
